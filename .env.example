# ============================================================
# SISRESERVA IFRO — Exemplo de Variáveis de Ambiente (.env)
# Não versione dados reais. Copie este arquivo para configuração local.
# ============================================================

# Host do Banco de Dados (Ex: localhost ou 127.0.0.1)
DB_HOST=localhost

# Porta do MySQL / MariaDB (padrão XAMPP: 3306)
DB_PORT=3306

# Nome da Base de Dados
DB_NAME=sisreserva

# Usuário do Banco de Dados (padrão XAMPP: root)
DB_USER=root

# Senha do Banco de Dados (deixe vazio caso seu XAMPP não possua senha)
DB_PASS=

# Fuso horário (Porto Velho / Rondônia: America/Porto_Velho)
TIMEZONE=America/Porto_Velho
