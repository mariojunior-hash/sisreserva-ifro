# ============================================================
# SISRESERVA IFRO — Configuração de Segurança Apache (.htaccess)
# ============================================================

# Desativa a listagem de diretórios
Options -Indexes

# Define o charset padrão UTF-8
AddDefaultCharset UTF-8

# Bloqueia acesso a arquivos sensíveis (.env, .git, .sql, etc.)
<FilesMatch "^\.|\.(env|sql|log|md|ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Bloqueia acesso direto às pastas estruturais protegidas
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(config|includes|database)/.*$ - [F,L]
</IfModule>
